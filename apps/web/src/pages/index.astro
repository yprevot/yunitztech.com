---
import Home from "../components/Home.astro";
import { api } from "../lib/api";
let content: any,
  posts: any[] = [];
try {
  [content, posts] = await Promise.all([api("site/es"), api("posts/es")]);
} catch {
  Astro.response.status = 503;
}
---

<Home lang="es" content={content} posts={posts} />
